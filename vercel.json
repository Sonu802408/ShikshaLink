{
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "https://shikshalink-api.onrender.com/uploads/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://shikshalink-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
